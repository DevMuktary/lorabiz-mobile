{
  "expo": {
    "name": "LoraBiz",
    "slug": "lorabiz",
    "scheme": "lorabiz",
    "version": "1.0.1",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "splash": {
      "image": "./assets/logo-white.png",
      "backgroundColor": "#C82D75",
      "resizeMode": "contain"
    },
    "ios": {
      "userInterfaceStyle": "automatic",
      "supportsTablet": true,
      "bundleIdentifier": "com.lorabiz.com",
      "buildNumber": "2",
      "infoPlist": {
        "NSCameraUsageDescription": "LoraBiz requires camera access to capture registration documents and passport photographs.",
        "NSFaceIDUsageDescription": "LoraBiz uses Face ID for fast and secure authentication into your wallet and account.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.lorabiz.com",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#C82D75",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow LoraBiz to use Face ID for fast and secure authentication."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "LoraBiz needs access to your gallery to upload document slips and certificates."
        }
      ],
      "expo-image",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.facebook.react.** { *; }\n-keep class com.facebook.hermes.** { *; }\n-keepattributes Signature\n-keepattributes *Annotation*"
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9f476dfa-0dbc-442c-bf85-0067d3b8e4d8"
      }
    }
  }
}
